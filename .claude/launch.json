{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "kumpir-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--workspace",
        "apps/web",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "kumpir-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--workspace",
        "apps/web",
        "run",
        "start",
        "--",
        "-p",
        "3100"
      ],
      "port": 3100
    }
  ]
}
