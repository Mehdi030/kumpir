# =========================
# RELAY (Next.js + TS + Supabase) .gitignore
# =========================

# --- dependencies ---
node_modules/
.pnp
.pnp.js

# --- Next.js ---
.next/
out/
build/
.vercel

# --- production/build artifacts ---
dist/

# --- env / secrets (NEVER COMMIT) ---
.env
.env.*
!.env.example
!.env.sample
!.env.local

# --- logs ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# --- TypeScript ---
*.tsbuildinfo

# next/ts generated types (safe to ignore)
next-env.d.ts

# --- OS ---
.DS_Store
Thumbs.db

# --- IDEs / editors ---
.idea/
.vscode/
*.iml

# --- cache ---
.cache/
.eslintcache
.turbo/

# --- certificates / keys ---
*.pem
*.key
*.crt

# --- misc ---
*.swp
