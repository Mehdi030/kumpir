# =========================
# RELAY (Next.js + TS + Supabase)
# .gitignore
# =========================

# --- Dependencies ---
node_modules/
.pnp
.pnp.js

# --- Next.js ---
.next/
out/
build/
.vercel/

# --- Production / Build Artifacts ---
dist/

# --- Environment / Secrets (NEVER COMMIT) ---
.env
.env.*
!.env.example
!.env.sample

# --- Logs ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# --- TypeScript ---
*.tsbuildinfo
next-env.d.ts

# --- Operating Systems ---
.DS_Store
Thumbs.db

# --- IDEs / Editors (LOCAL ONLY, NEVER COMMIT) ---
.idea/          # WebStorm / IntelliJ config
.vscode/        # VS Code config
*.iml           # IntelliJ module files
*.xml           # IDE XML files (workspace.xml, vcs.xml, modules.xml, etc.)

# --- Cache ---
.cache/
.eslintcache
.turbo/

# --- Certificates / Keys ---
*.pem
*.key
*.crt

# --- Misc ---
*.swp
