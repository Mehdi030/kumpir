# =========================
# Monorepo (Next.js + TS + Python + Supabase)
# Root .gitignore
# =========================

########################################
# Dependencies (Node)
########################################
**/node_modules/
.pnp
.pnp.js

########################################
# Next.js / Frontend build output
########################################
**/.next/
**/out/
**/dist/
**/build/
**/.vercel/

########################################
# Turborepo / caches
########################################
**/.turbo/
**/.cache/
**/.eslintcache

########################################
# Environment / Secrets (NEVER COMMIT)
########################################
**/.env
**/.env.*
!.env.example
!.env.sample

########################################
# Logs
########################################
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*
**/*.log

########################################
# TypeScript
########################################
**/*.tsbuildinfo

# Hinweis: next-env.d.ts solltest du NICHT global ignorieren,
# weil Next.js es als Datei im Projekt erwartet.
# Falls du es ignorieren willst, nur als Generated-File in einer App:
# apps/web/next-env.d.ts
# (Ich empfehle: NICHT ignorieren.)

########################################
# Python (Logic)
########################################
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.coverage
**/coverage.xml
**/htmlcov/

# Virtual environments
**/venv/
**/.venv/
**/env/

########################################
# Supabase / local state
########################################
**/.supabase/

########################################
# IDEs / Editors
########################################
.idea/
.vscode/
*.iml

########################################
# Claude Code (lokale Worktrees, keine Projekt-Config)
########################################
.claude/worktrees/

########################################
# OS / Misc
########################################
.DS_Store
Thumbs.db
**/*.swp
**/*.tmp
**/*.orig
