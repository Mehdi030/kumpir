# ============================================================
# KUMPIR – Lokales Test-Setup
# ============================================================
# Kopiere diese Datei zu `.env.local` (im selben Ordner) und
# trage deine echten Supabase-Werte ein. .env.local wird NIE
# committed (siehe Root-.gitignore).
#
#   cp apps/web/.env.example apps/web/.env.local
#
# Die Werte findest du im Supabase-Dashboard:
#   https://supabase.com/dashboard/project/_/settings/api
# ============================================================

# Pflicht: Supabase Projekt-URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxx.supabase.co

# Pflicht: Public Anon Key (NICHT der service_role Key!)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------
# Optional: Auth komplett überspringen (super zum schnellen Testen)
# Wenn "1": kein Login nötig, du kommst direkt in /host und /join.
# Im Prod auf "0" oder weglassen.
# ------------------------------------------------------------
NEXT_PUBLIC_AUTH_DISABLED=1
